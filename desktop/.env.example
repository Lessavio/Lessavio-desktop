# Public Firebase Web app configuration (not Admin SDK / service account credentials).
# Copy this file to .env and fill in values. VITE_* values are public in the built app.
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google OAuth client of type Desktop app, from the same Google Cloud/Firebase project.
# Add this client to Firebase Google provider authorized client IDs when needed.
VITE_GOOGLE_DESKTOP_CLIENT_ID=

{
  "name": "backend-test-express",
  "version": "1.0.0",
  "description": "Tutorly full-stack app for tutors",
  "private": true,
  "workspaces": [
    "client"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm run build --workspace=tutorly-client",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --files src/index.ts",
    "dev:server": "ts-node-dev --respawn --files src/index.ts",
    "dev:client": "npm run dev --workspace=tutorly-client"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
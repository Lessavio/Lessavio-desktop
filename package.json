{
  "name": "backend-test-express",
  "version": "1.0.0",
  "description": "Tutorly full-stack app for tutors",
  "private": true,
  "overrides": {
    "qs": "6.16.0"
  },
  "workspaces": [
    "client"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm run build --workspace=tutorly-client",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --files src/index.ts",
    "dev:server": "ts-node-dev --respawn --files src/index.ts",
    "dev:client": "npm run dev --workspace=tutorly-client",
    "db:migrate": "ts-node --files src/database/migrate.ts",
    "db:import-json": "ts-node --files src/database/import-json.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "^4.21.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@neon/config": "1.3.1",
    "@neon/env": "1.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "8.23.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}